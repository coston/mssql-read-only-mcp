{
  "name": "mssql-read-only-mcp",
  "version": "1.0.2",
  "description": "Read-Only MSSQL MCP Server with SQL Authentication",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mssql-read-only-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest": "npm run lint && npm run build",
    "pretest:integration": "npm run build",
    "preversion": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "mssql",
    "sql-server",
    "database"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/coston/mssql-read-only-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coston/mssql-read-only-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/coston/mssql-read-only-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@testcontainers/mssqlserver": "^11.8.1",
    "@types/mssql": "^9.1.7",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.0.13",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "testcontainers": "^11.8.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.13"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "src/**/*.ts": [
      "vitest related --run tests/unit"
    ]
  }
}
